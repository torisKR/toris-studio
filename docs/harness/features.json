{
 "$comment": "Which code each feature owns and what proves it works. scripts/harness-check.mjs keeps this honest.",
 "features": [
  {
   "id": "agent-runtime",
   "label": "Agent 탭 LangGraph 런타임과 하네스",
   "paths": [
    "desktop/agent-runtime/**",
    "scripts/build-agent-runtime.mjs"
   ],
   "verify": [
    "pnpm agent:typecheck",
    "pnpm agent:test"
   ],
   "mutants": [
    "desktop/agent-runtime/test/mutants.json"
   ]
  },
  {
   "id": "agent-ui",
   "label": "Agent 탭 화면",
   "paths": [
    "desktop/src/Agent*",
    "desktop/src/agent-*.ts",
    "desktop/src/PixelOffice.tsx",
    "desktop/src/pixel-*.ts",
    "scripts/verify-agent-ui.mjs"
   ],
   "verify": [
    "node --import tsx --test tests/agent-client.test.ts tests/agent-office.test.ts tests/pixel-office.test.ts",
    "node scripts/verify-agent-ui.mjs"
   ],
   "mutants": [
    "desktop/agent-runtime/test/ui-mutants.json"
   ]
  },
  {
   "id": "video",
   "label": "영상 제작·모션·렌더",
   "paths": [
    "desktop/src/Video*",
    "desktop/src/video-*.ts",
    "desktop/src/NativeRenderPreview*",
    "desktop/src-tauri/src/media.rs",
    "desktop/src-tauri/src/motion.rs",
    "desktop/src-tauri/src/video_*.rs",
    "lib/video/**",
    "lib/render/**",
    "remotion/**",
    "skills/toris-video-motion/**",
    "scripts/verify-video-templates.mjs",
    "scripts/render-*.ts",
    "desktop/src/motion/**",
    "scripts/verify-motion-*.mjs",
    "scripts/build-media-runtime.sh"
   ],
   "verify": [
    "node --import tsx --test tests/video-*.test.ts tests/editing.test.ts tests/update-scene.test.ts",
    "cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --lib motion:: media:: video_"
   ]
  },
  {
   "id": "voice",
   "label": "로컬 TTS·STT",
   "paths": [
    "lib/tts/**",
    "lib/stt/**",
    "scripts/*qwen*",
    "scripts/*whisper*",
    "scripts/qwen_tts_*.py"
   ],
   "verify": [
    "node --import tsx --test tests/tts-*.test.ts tests/voice-generation.test.ts"
   ]
  },
  {
   "id": "publishing",
   "label": "SNS 게시·예약·OAuth",
   "paths": [
    "desktop/src/Publication*",
    "desktop/src/publication-client.ts",
    "desktop/src/OAuth*",
    "desktop/src/YouTube*",
    "desktop/src/Integration*",
    "desktop/src-tauri/src/publication*.rs",
    "desktop/src-tauri/src/publishing*.rs",
    "desktop/src-tauri/src/oauth*.rs",
    "desktop/src-tauri/src/youtube.rs",
    "desktop/src-tauri/src/chatgpt_drafts.rs",
    "desktop/src-tauri/src/integration_native.rs",
    "infrastructure/oauth-callback/**",
