    "node --import tsx --test tests/planner-client.test.ts",
    "cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --lib planner::",
    "node scripts/verify-planner-ui.mjs"
   ]
  },
  {
   "id": "ops",
   "label": "제품 운영 상태 대시보드",
