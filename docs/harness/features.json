    "desktop/src/ChatGPTHandoff.tsx",
    "desktop/src/creation-client.ts",
    "scripts/creation-native-fixture.mjs"
   ],
   "verify": [
    "node --import tsx --test tests/publication-*.test.ts tests/youtube-upload.test.ts",
    "cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --lib publish oauth"
   ]
  },
  {
   "id": "planner",
   "label": "일정·작업·Google Calendar",
   "paths": [
    "desktop/src/Planner*",
    "desktop/src/planner-*.ts",
