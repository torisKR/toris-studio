    "desktop/src-tauri/src/trends.rs",
    "desktop/src-tauri/src/keyword.rs",
    "desktop/src-tauri/src/models.rs",
    "desktop/src-tauri/src/ai.rs",
    "desktop/src-tauri/src/scheduler.rs",
    "desktop/src-tauri/src/agent_native.rs",
    "desktop/src-tauri/src/agent_runtime.rs",
    "desktop/src-tauri/src/hub*.rs",
    "lib/social/**",
    "lib/ai/**",
    "lib/storage/**",
    "lib/security/**",
    "db/**",
    "app/**",
    "components/**",
