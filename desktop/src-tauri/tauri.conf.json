{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toris Studio",
  "version": "0.2.0",
  "identifier": "kr.toris.studio",
  "build": {
    "beforeDevCommand": "pnpm --dir .. exec vite --config desktop/vite.config.ts",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir .. exec vite build --config desktop/vite.config.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Toris Studio",
        "width": 1380,
        "height": 900,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost blob:; img-src 'self' asset: http://asset.localhost data: blob: https://i.ytimg.com; media-src 'self' asset: http://asset.localhost blob: toris-preview: http://toris-preview.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "\ub85c\uceec \ucc44\ub110 \uad00\ub9ac\uc640 \ucf58\ud150\uce20 \ub9ac\uc11c\uce58",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": [
          "Korean",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMERFNDNFNkI5MjIwQTcKUldTbklKSnJQdVFORTY4RnJpMzJSMlR1eCtIM1B0d1lKNnAzWEx0c3BzQmF4QVBHYTFhb1ZBUFAK",
      "endpoints": [
        "https://github.com/torisKR/toris-studio/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
