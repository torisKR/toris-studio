{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "toris-oauth-broker",
  "main": "worker.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "oauth.toris.kr", "custom_domain": true },
    // toris-site owns a wildcard route on this zone; the more specific route makes this Worker answer first.
    { "pattern": "oauth.toris.kr/*", "zone_name": "toris.kr" }
  ],
  // Invocation logs record request URLs; this Worker keeps no logs at all.
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": false
    }
  },
  // Per-IP limits. Cloudflare allows only 10- or 60-second periods; counts are approximate per location.
  "ratelimits": [
    { "name": "START_LIMITER", "namespace_id": "38471001", "simple": { "limit": 20, "period": 60 } },
    { "name": "TOKEN_LIMITER", "namespace_id": "38471002", "simple": { "limit": 10, "period": 60 } },
    { "name": "REFRESH_LIMITER", "namespace_id": "38471003", "simple": { "limit": 30, "period": 60 } },
    { "name": "SEARCH_LIMITER", "namespace_id": "38471004", "simple": { "limit": 30, "period": 60 } }
  ],
  // Shared daily Naver search counter: stores {day, count} only.
  "durable_objects": {
    "bindings": [
      { "name": "SEARCH_BUDGET", "class_name": "SearchBudget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SearchBudget"] }
  ],
  // Public values only. Secrets go through `wrangler secret put` (see README). Empty client IDs keep a platform disabled.
  "vars": {
    "TIKTOK_CLIENT_KEY": "",
    "THREADS_APP_ID": "",
    "INSTAGRAM_APP_ID": "",
    "FACEBOOK_APP_ID": "",
    "NAVER_LOGIN_CLIENT_ID": "",
    "NAVER_SEARCH_CLIENT_ID": "",
    "STATE_KEY_ID": "k1",
    "MIN_APP_VERSION": "0.8.0",
    "ENABLED_PLATFORMS": "tiktok,threads,instagram,facebook,naver_blog",
    "NAVER_SEARCH_DAILY_BUDGET": "20000"
  }
}
