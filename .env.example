# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
TORIS_STUDIO_DATA_DIR=.toris-studio

# Local social management DB (generated securely by pnpm db:start).
# Never set this or provider credentials as NEXT_PUBLIC_*.
DATABASE_URL=

# Local OpenCodex reuses its existing authenticated accounts.
# Model IDs must appear in both the provider catalog and this explicit allowlist.
OPENCODEX_BASE_URL=http://127.0.0.1:10100/v1
OPENCODEX_API_KEY=
OPENCODEX_MODEL=gpt-6.1-sol
OPENCODEX_ALLOWED_MODELS=gpt-6.1-sol

# Optional compatible local TeamClaude gateway. Leave blank unless installed.
TEAMCLAUDE_BASE_URL=
TEAMCLAUDE_API_KEY=
TEAMCLAUDE_MODEL=
TEAMCLAUDE_ALLOWED_MODELS=

# Official Claude Code uses its own subscription login / OS credential store.
CLAUDE_CLI_ENABLED=false
CLAUDE_CLI_PATH=claude

# Optional official data APIs. Google Trends KR RSS works without API keys.
YOUTUBE_DATA_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase (optional until cloud persistence is enabled)
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Prefer the modern Supabase secret key on new projects.
SUPABASE_SECRET_KEY=
# Legacy fallback during the key transition period.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=toris-studio-assets

# Fully local Korean TTS: Qwen3-TTS MLX on Apple Silicon
QWEN_TTS_BASE_URL=http://127.0.0.1:50010
QWEN_TTS_SPEAKER=Sohee
QWEN_TTS_LANGUAGE=Korean
QWEN_TTS_INSTRUCT=따뜻하고 자연스러운 한국 여성 목소리. 실제 사람이 말하듯 편안하고 부드럽게, 광고처럼 과장하지 말고 문장마다 자연스럽게 호흡하며 또렷하게 말한다.

# Local STT
# whisper_cpp uses the official whisper.cpp server POST /inference endpoint.
# openai_compatible uses POST /v1/audio/transcriptions instead.
STT_PROVIDER=whisper_cpp
STT_BASE_URL=http://127.0.0.1:8080
STT_MODEL=local
STT_API_KEY=

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
# MVP: generate an OAuth refresh token once and keep it server-side only.
YOUTUBE_REFRESH_TOKEN=

# MCP bridge for ChatGPT / MCP-capable clients
TORIS_STUDIO_API_URL=http://127.0.0.1:3000
MCP_PORT=3100
MCP_HOST=127.0.0.1

# Linux render (installed Chromium avoids a browser download at render time)
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
REMOTION_CONCURRENCY=2
REMOTION_SCALE=1
# For restricted HOME environments, set XDG_CACHE_HOME to a writable directory.
# Optional native PyTorch voice runtime (see docs/LINUX.md)
# QWEN_TTS_MODEL_DIR=/absolute/path/to/CustomVoice-model
# QWEN_TTS_DEVICE=cpu
# QWEN_TTS_THREADS=2
