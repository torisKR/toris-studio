{
  "name": "toris-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:clean": "rm -rf node_modules/.cache/webpack",
    "remotion:render": "tsx scripts/render-demo.ts",
    "mcp": "tsx mcp/server.ts",
    "mcp:stdio": "tsx mcp/stdio.ts",
    "assets:worker:build": "cargo build --manifest-path desktop/src-tauri/Cargo.toml --no-default-features",
    "assets:mcp": "tsx mcp/asset-stdio.ts",
    "ai:verify:ui": "node scripts/verify-ai-workspace.mjs",
    "ai:test": "node --import tsx --test tests/ai-discovery.test.ts tests/codexify-bridge.test.ts tests/codexify-client.test.ts",
    "codexify:verify": "cargo build --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --bin toris-studio-desktop && node scripts/verify-codexify-direct.mjs",
    "integrations:verify:ui": "node scripts/verify-integration-ui.mjs",
    "integrations:verify:mcp": "cargo build --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --bin toris-studio-desktop && node scripts/verify-asset-mcp.mjs --native",
    "integrations:test": "cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --test release_integration_contract && cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --lib oauth::upload_tests",
    "assets:verify:mcp": "node scripts/verify-asset-mcp.mjs",
    "assets:verify:ui": "cargo build --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --bin toris-studio-desktop --example asset_qa_bridge && node scripts/verify-asset-studio.mjs",
    "assets:test": "node --import tsx --test tests/asset-*.test.ts && cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --test asset_contract --test asset_resize_contract --test asset_failure_contract",
    "assets:audit": "cargo build --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --bin toris-studio-desktop --example asset_qa_bridge && node scripts/audit-desktop-functional.mjs",
    "qa:live:preflight": "cargo run --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --example live_integration_probe -- --live",
    "qa:live:database": "TORIS_SOCIAL_DATABASE_INTEGRATION=1 node --env-file=.env.local --import tsx --test tests/social-database.test.ts",
    "qa:live:oauth": "TORIS_LIVE_OAUTH_QA=1 cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features --lib oauth::live_tests::saved_youtube_and_naver_grants_roundtrip_and_refresh -- --ignored --nocapture",
    "qa:live:web": "node scripts/verify-live-web-upload.mjs",
    "qa:upload:contract": "node --import tsx --test tests/youtube-upload.test.ts",
    "tts:setup": "bash scripts/setup-qwen3-tts-macos.sh",
    "tts:start": "bash scripts/start-qwen3-tts-macos.sh",
    "tts:on": "bash scripts/start-qwen3-tts-macos.sh on",
    "tts:off": "bash scripts/start-qwen3-tts-macos.sh off",
    "tts:status": "bash scripts/start-qwen3-tts-macos.sh status",
    "setup:linux": "bash scripts/setup-linux.sh",
    "render:project": "tsx scripts/render-project.ts",
    "tts:setup:linux": "bash scripts/setup-qwen3-tts-linux.sh",
    "tts:start:linux": "bash scripts/start-qwen3-tts-linux.sh",
    "test": "node --import tsx --test tests/*.test.ts",
    "devday:prepare": "tsx scripts/prepare-devday.ts",
    "db:start": "bash scripts/db-start.sh",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:backup": "bash scripts/db-backup.sh",
    "security:check": "bash scripts/check-secrets.sh",
    "local:on": "node scripts/local-services.mjs start",
    "local:off": "node scripts/local-services.mjs stop",
    "local:status": "node scripts/local-services.mjs status",
    "trends:collect": "node scripts/trend-worker.mjs --once",
    "trends:worker": "node scripts/trend-worker.mjs",
    "desktop:dev": "pnpm --dir desktop exec tauri dev",
    "desktop:build": "pnpm --dir desktop exec tauri build",
    "desktop:check": "tsc --project desktop/tsconfig.json --noEmit && cargo test --manifest-path desktop/src-tauri/Cargo.toml --no-default-features",
    "desktop:ui": "vite build --config desktop/vite.config.ts",
    "desktop:smoke": "cargo run --manifest-path desktop/src-tauri/Cargo.toml -- --self-check"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.1",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/media": "4.0.530",
    "@remotion/player": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "@supabase/supabase-js": "2.117.2",
    "@tauri-apps/api": "^2.12.1",
    "express": "5.2.1",
    "fast-xml-parser": "5.11.2",
    "googleapis": "182.0.0",
    "lucide-react": "1.49.0",
    "next": "16.3.7",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.530",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "^8.3.3"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  }
}
